# ── Module A runtime ──
apps/auto-extract/inbox/*
apps/auto-extract/downloads/*
apps/auto-extract/result/*
apps/auto-extract/logs/*
apps/auto-extract/state/*
!apps/auto-extract/inbox/.gitkeep
!apps/auto-extract/downloads/.gitkeep
!apps/auto-extract/result/.gitkeep
!apps/auto-extract/logs/.gitkeep
!apps/auto-extract/state/.gitkeep

# ── Workspace (per-task dirs under workspace/<task_key>/) ──
apps/auto-extract/workspace/*
!apps/auto-extract/workspace/.gitkeep

