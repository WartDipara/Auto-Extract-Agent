# --- required (always) ---
# feishu | dingtalk
IM_CHANNEL=feishu

# --- required when IM_CHANNEL=feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- required when IM_CHANNEL=dingtalk ---
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# --- optional ---
# DINGTALK_ROBOT_CODE=
#   Defaults to DINGTALK_CLIENT_ID. Set only if robotCode differs from Client ID.
#
# ANNOUNCE_CHAT_ID=
#   Optional pin(s) always included in lifecycle broadcast (online/offline/core).
#   Comma-separated for multiple pins. Also accumulates every group that @'s the bot
#   (state/announce_chat.json → chat_ids). Task results still go only to im_chat_id.
#   DingTalk pin fallback: DINGTALK_TEST_CHAT_ID.
#
# ZIP_PASSWORD is read from apps/auto-extract/.env (encrypted result .zip).
