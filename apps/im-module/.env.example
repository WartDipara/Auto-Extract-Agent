# --- required (always) ---
# feishu | dingtalk
IM_CHANNEL=feishu

# --- required when IM_CHANNEL=feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- required when IM_CHANNEL=dingtalk ---
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# --- optional ---
# DINGTALK_ROBOT_CODE=
#   Defaults to DINGTALK_CLIENT_ID. Set only if robotCode differs from Client ID.
#
# ANNOUNCE_CHAT_ID=
#   Optional pin for online/offline/core-fault announces.
#   Leave empty to auto-learn from the last group/@ chat
#   (saved under state/announce_chat.json). Swap groups → just @bot once.
#   DingTalk pin fallback: DINGTALK_TEST_CHAT_ID.
#
# ZIP_PASSWORD is read from apps/auto-extract/.env when needed.
