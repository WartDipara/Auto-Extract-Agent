IM_CHANNEL=feishu

# Feishu / Lark
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Feishu Bitable sync (@机器人 同步)
# FEISHU_BITABLE_APP_TOKEN=  # from /base/<token> URL
# FEISHU_BITABLE_TABLE_ID=   # tbl...
# FEISHU_SYNC_COMMANDS=同步,sync
# SHEET_SEEN_FILE=
# SHEET_SYNC_BATCH_SIZE=50

# DingTalk (Stream mode robot)
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=  # AppKey / Client ID
# DINGTALK_CLIENT_SECRET=  # AppSecret / Client Secret
# DINGTALK_ROBOT_CODE=  # optional; defaults to Client ID / AppKey
