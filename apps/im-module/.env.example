# --- required (always) ---
# feishu | dingtalk
IM_CHANNEL=feishu

# --- required when IM_CHANNEL=feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- required when IM_CHANNEL=dingtalk ---
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# --- optional ---
# DINGTALK_ROBOT_CODE=
#   Defaults to DINGTALK_CLIENT_ID. Set only if robotCode differs from Client ID.
#
# TASKS_DB=
#   Default: apps/auto-extract/state/tasks.db (must match Module A if overridden)
