IM_CHANNEL=feishu

# Feishu / Lark
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# DingTalk (Stream mode robot)
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=  # AppKey / Client ID
# DINGTALK_CLIENT_SECRET=  # AppSecret / Client Secret
# DINGTALK_ROBOT_CODE=  # optional; defaults to Client ID / AppKey

# Shared Module A ledger
# TASKS_DB=  # default: apps/auto-extract/state/tasks.db
# QUERY_EXPORT_DIR=

# Live tests: tests/test_dingtalk_live.py (set DINGTALK_LIVE=1 in shell)
# DINGTALK_TEST_CHAT_ID=group:cidxxxx
# DINGTALK_LIVE_TIMEOUT_SEC=120
