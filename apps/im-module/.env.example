# --- required (always) ---
# feishu | dingtalk
IM_CHANNEL=feishu

# --- required when IM_CHANNEL=feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- required when IM_CHANNEL=dingtalk ---
# IM_CHANNEL=dingtalk
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# --- optional ---
# DINGTALK_ROBOT_CODE=
#   Defaults to DINGTALK_CLIENT_ID. Set only if robotCode differs from Client ID.
#
# ANNOUNCE_CHAT_ID=
#   Group/chat for online/offline/core-fault announces.
#   DingTalk: group:cid…  Feishu: chat_id
#   DingTalk fallback: DINGTALK_TEST_CHAT_ID if ANNOUNCE_CHAT_ID empty.
#
# TASKS_DB=
#   Default: apps/auto-extract/state/tasks.db (must match Module A if overridden)
#
# QUERY_EXPORT_DIR=
#   Default: apps/im-module/state/query_exports (query export xlsx)
#
# CORE_HEARTBEAT_PATH=
#   Default: apps/auto-extract/state/heartbeat
# CORE_HEARTBEAT_STALE_SEC=45
