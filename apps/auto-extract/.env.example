# --- required ---
API_KEY=
# Native: openai:… | anthropic:… | deepseek:…
# Or plain model name when BASE_URL points at an OpenAI-compatible node.
MODEL_ID=
# Encrypted result .zip password (sent back via IM after success)
ZIP_PASSWORD=

# --- optional ---
# OpenAI-compatible base (NO /chat/completions suffix; client appends it).
# BASE_URL=https://api.example.com/v1
#
# Optional adb device serial pin (empty = auto).
# ADB_SERIAL=
