# --- required ---
API_KEY=
# Native: openai:… | anthropic:… | deepseek:…
# Or plain model name when BASE_URL points at an OpenAI-compatible node.
MODEL_ID=
# buf_done AES zip password 
ZIP_PASSWORD=

# --- optional ---
# OpenAI-compatible endpoint (Minimax / GLM / self-host). Leave empty for native providers.
# BASE_URL=https://api.example.com/v1
#
# Optional adb device serial pin (empty = auto).
# ADB_SERIAL=
