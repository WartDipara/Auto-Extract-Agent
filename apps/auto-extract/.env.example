# --- required ---
# prep small_agent LLM key
API_KEY=
# buf_done AES zip password (no default; pack fails if empty)
ZIP_PASSWORD=

# --- optional ---
# LLM model id. Default if omitted: deepseek:deepseek-chat
# Native providers: openai:… | anthropic:… | deepseek:…
# MODEL_ID=deepseek:deepseek-chat
#
# Custom OpenAI-compatible node (Minimax / GLM / self-host).
# When set, MODEL_ID is the model name on that node (provider prefix stripped).
# BASE_URL=https://api.example.com/v1
# MODEL_ID=your-model-name
